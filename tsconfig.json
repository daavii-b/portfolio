{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*":["./src/components/*"],
      "@/lib/*":["./src/lib/*"],
      "@/pages/*":["./src/pages/*"],
      "@/styles/*":["./src/styles/*"]
    }
  },
  "include": [
    "src"
  ]
}